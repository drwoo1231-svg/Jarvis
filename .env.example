# Copy this file to .env and fill in your key, or export these in your shell.
# The server reads process.env directly (no dotenv dependency), so either:
#   export ANTHROPIC_API_KEY=sk-ant-...   &&  npm start
# or use a loader of your choice.

# Your Anthropic API key. Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Which Claude model JARVIS uses (default: claude-sonnet-5).
# Options: claude-sonnet-5 | claude-opus-4-8 | claude-haiku-4-5-20251001
JARVIS_MODEL=claude-sonnet-5

# Port to listen on (default 3000).
PORT=3000

# Max tokens per reply (default 1024).
JARVIS_MAX_TOKENS=1024
